{
  "_comment": "Editable rules mapping Coinbase document titles to filename summaries, checked in order, tax first, then insurance (unused), then statement. Statements are the monthly account statements on the Statements page and the Coinbase One Card statements on its Credit Card tab, and tax documents are the forms and reports on the Taxes page. Repair after reading a recording or diagnose output.",
  "tax_rules": [
    {
      "pattern": "\\b1099-?DA\\b",
      "summary": "1099-DA Tax Form"
    },
    {
      "pattern": "\\b1099-?MISC\\b",
      "summary": "1099-MISC Tax Form"
    },
    {
      "pattern": "\\b1099-?B\\b",
      "summary": "1099-B Tax Form"
    },
    {
      "pattern": "\\b1099-?K\\b",
      "summary": "1099-K Tax Form"
    },
    {
      "pattern": "\\b1042-?S\\b",
      "summary": "1042-S Tax Form"
    },
    {
      "pattern": "\\b1099\\b",
      "summary": "1099 Tax Form"
    },
    {
      "pattern": "gain(s)?\\s*(/|and|&)?\\s*loss(es)?",
      "summary": "Gain Loss Report"
    },
    {
      "pattern": "tax\\s+(document|form|statement|report|summary)",
      "summary": "Tax Document"
    }
  ],
  "insurance_rules": [],
  "statement_rules": [
    {
      "pattern": "coinbase\\s+one\\s+card\\s+statement",
      "summary": "One Card Statement"
    },
    {
      "pattern": "\\bstatement\\b",
      "summary": "Monthly Statement"
    },
    {
      "pattern": "transaction\\s+history",
      "summary": "Transaction History"
    }
  ],
  "skip_patterns": [
    "privacy\\s+(notice|policy)",
    "terms\\s+(of\\s+service|and\\s+conditions)",
    "\\bfaq\\b",
    "custom\\s+statement",
    "generate"
  ]
}
